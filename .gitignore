# ==========================================
# STM32CubeIDE & CubeMX Git Ignore Configuration
# ==========================================

# 1. Build Directories (Automatically generated by IDE)
# Ignore build folders (standard defaults are Debug and Release)
[Dd]ebug/
[Rr]elease/
[Bb]uild/

# 2. Output and Build Artifacts
# These files are generated during compilation and should not be tracked
*.elf
*.hex
*.bin
*.map
*.list
*.su
*.o
*.d
*.a
*.la
*.lai
*.lo
*.obj
*.lst
*.su

# 3. IDE / Toolchain Specific Config (Local settings)
# Ignore local eclipse preferences and run configurations which may contain local file paths
.settings/
*.launch
*.jlink

# 4. STM32CubeMX generated local files & backups
# If CubeMX creates backup files, ignore them
*.mxproject.bak
*~

# 5. OS and Editor files
# Operating System specific files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor backup/temp files
*.bak
*.swp
*.tmp
*~
